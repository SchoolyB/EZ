/*
 * Error Test: E3066 - func-typed generic parameter given a function whose
 * signature does not match the bound type
 * Expected: compile-time error on the function reference argument
 */

do apply(kind generic, f func(kind) -> kind, v kind) -> kind {
    return f(v)
}

do inc(x i64) -> i64 {
    return x + 1
}

do main() {
    println(apply(string, ()inc, "x"))
}
