/*
 * Error Test: E5026 - json.encode() on a struct without the #json
 * attribute. Without it, codegen falls back to reinterpreting the struct's
 * raw memory as a GrayMap, compiling and running clean while silently
 * discarding every field and returning "{}" with no diagnostic.
 */
// expect-error: E5026
// expect-error-count: 1

import @json

const Plain struct {
    x i64
}

do main() {
    mut p Plain = Plain{x: 1}
    println(json.encode(p))
}
