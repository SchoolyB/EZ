/*
 * Error Test: E7015 - len() on a user struct that shares a stdlib type name
 *
 * A user struct named Builder, with the strings module not imported, is not
 * the stdlib Builder and has no length.
 */

const Builder struct {
    parts [string]
}

do main() {
    mut b Builder = Builder{parts: {"a", "b"}}
    println(len(b))
}
