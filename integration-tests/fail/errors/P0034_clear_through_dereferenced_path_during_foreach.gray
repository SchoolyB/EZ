// expect-contains: .gray:
/* Panic Test: P0034 - clear of an array iterated through an explicit dereference during for_each */
import @arrays

const S struct { items [i64] }

do main() {
    mut p ^S = new(S)
    p^.items = {1, 2, 3}
    for_each x in p^.items {
        arrays.clear(p^.items)
        println(x)
    }
}
