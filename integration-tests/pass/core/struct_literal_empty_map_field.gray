const Table struct {
    counts map[string:i64]
}

do make() -> Table {
    return Table{counts: {}}
}

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut declared = Table{counts: {}}
    declared.counts["b"] = 2
    if len(declared.counts) == 1 && declared.counts["b"] == 2 {
        passed += 1
    } otherwise {
        failed += 1
    }

    mut returned = make()
    returned.counts["a"] = 1
    if len(returned.counts) == 1 {
        passed += 1
    } otherwise {
        failed += 1
    }

    if failed == 0 {
        println("ALL TESTS PASSED")
    } otherwise {
        println("SOME TESTS FAILED")
    }
}
