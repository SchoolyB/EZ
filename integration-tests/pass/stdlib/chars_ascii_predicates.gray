/*
 * strings_char_classification.gray - Integration test for chars classification predicates
 */

import @chars

do main() {
    println("=== Chars Classification Predicates Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // is_alpha - true
    if chars.is_alpha('a') == true {
        println("  [PASS] is_alpha letter")
        passed += 1
    } otherwise {
        println("  [FAIL] is_alpha letter")
        failed += 1
    }

    // is_alpha - false
    if chars.is_alpha('1') == false {
        println("  [PASS] is_alpha digit (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_alpha digit (false)")
        failed += 1
    }

    // is_digit - true
    if chars.is_digit('9') == true {
        println("  [PASS] is_digit digit")
        passed += 1
    } otherwise {
        println("  [FAIL] is_digit digit")
        failed += 1
    }

    // is_digit - false
    if chars.is_digit('z') == false {
        println("  [PASS] is_digit letter (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_digit letter (false)")
        failed += 1
    }

    // is_alnum - letter
    if chars.is_alnum('b') == true {
        println("  [PASS] is_alnum letter")
        passed += 1
    } otherwise {
        println("  [FAIL] is_alnum letter")
        failed += 1
    }

    // is_alnum - digit
    if chars.is_alnum('3') == true {
        println("  [PASS] is_alnum digit")
        passed += 1
    } otherwise {
        println("  [FAIL] is_alnum digit")
        failed += 1
    }

    // is_alnum - false
    if chars.is_alnum('!') == false {
        println("  [PASS] is_alnum symbol (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_alnum symbol (false)")
        failed += 1
    }

    // is_whitespace - space
    if chars.is_whitespace(' ') == true {
        println("  [PASS] is_whitespace space")
        passed += 1
    } otherwise {
        println("  [FAIL] is_whitespace space")
        failed += 1
    }

    // is_whitespace - false
    if chars.is_whitespace('x') == false {
        println("  [PASS] is_whitespace letter (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_whitespace letter (false)")
        failed += 1
    }

    // is_upper - true
    if chars.is_upper('A') == true {
        println("  [PASS] is_upper uppercase")
        passed += 1
    } otherwise {
        println("  [FAIL] is_upper uppercase")
        failed += 1
    }

    // is_upper - false
    if chars.is_upper('a') == false {
        println("  [PASS] is_upper lowercase (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_upper lowercase (false)")
        failed += 1
    }

    // is_lower - true
    if chars.is_lower('z') == true {
        println("  [PASS] is_lower lowercase")
        passed += 1
    } otherwise {
        println("  [FAIL] is_lower lowercase")
        failed += 1
    }

    // is_lower - false
    if chars.is_lower('Z') == false {
        println("  [PASS] is_lower uppercase (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] is_lower uppercase (false)")
        failed += 1
    }

    // non-ASCII codepoints are never classified
    if chars.is_alpha('Ł') == false && chars.is_alnum('Ł') == false && chars.is_upper('Ł') == false && chars.is_lower('ł') == false {
        println("  [PASS] non-ASCII letters (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] non-ASCII letters (false)")
        failed += 1
    }

    if chars.is_digit('٣') == false && chars.is_whitespace('\u{00A0}') == false {
        println("  [PASS] non-ASCII digit and space (false)")
        passed += 1
    } otherwise {
        println("  [FAIL] non-ASCII digit and space (false)")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
        exit(1)
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
