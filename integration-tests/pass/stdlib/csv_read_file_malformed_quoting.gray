/*
 * Test: csv.read_file reports malformed quoting as an error
 */

import @csv
import @io

do main() {
    mut passed i64 = 0
    mut failed i64 = 0

    mut _, _ = io.write_file("/tmp/gray_csv_malformed_quoting.csv", "a,b\n\"x\"y,z")
    mut data, err = csv.read_file("/tmp/gray_csv_malformed_quoting.csv")
    if err != nil && len(data) == 0 {
        println("  [PASS] csv.read_file reports malformed quoting")
        passed += 1
    } otherwise {
        println("  [FAIL] csv.read_file accepted malformed quoting")
        failed += 1
    }
    mut _, _ = io.delete_file("/tmp/gray_csv_malformed_quoting.csv")

    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
