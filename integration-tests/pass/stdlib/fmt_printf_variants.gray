/*
 * fmt_printf_variants.gray - Integration tests for printfln, eprintf, eprintfln, sprintf with newline
 * Tests the new formatted output variants added.
 */

import @fmt

do main() {
    println("=== Fmt Printf Variants Test ===")
    mut passed i64 = 0
    mut failed i64 = 0

    // Test 1: sprintf with newline returns string with trailing newline
    mut s1 string = fmt.sprintf("hello %s\n", {"world"})
    if s1 == "hello world\n" {
        println("  [PASS] sprintf with newline basic")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf with newline basic: expected 'hello world\\n'")
        failed += 1
    }

    // Test 2: sprintf with newline with i64 arg
    mut s2 string = fmt.sprintf("x = %d\n", {42})
    if s2 == "x = 42\n" {
        println("  [PASS] sprintf with newline with i64")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf with newline with i64: expected 'x = 42\\n'")
        failed += 1
    }

    // Test 3: sprintf with newline with multiple args
    mut s3 string = fmt.sprintf("%s is %d\n", {"age", 25})
    if s3 == "age is 25\n" {
        println("  [PASS] sprintf with newline with multiple args")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf with newline with multiple args")
        failed += 1
    }

    // Test 4: printfln compiles and runs (output goes to stdout)
    fmt.printfln("  [INFO] printfln test: %s %d", {"value", 99})
    println("  [PASS] printfln runs without crash")
    passed += 1

    // Test 5: eprintf compiles and runs (output goes to stderr)
    fmt.eprintf("eprintf test: %s\n", {"stderr output"})
    println("  [PASS] eprintf runs without crash")
    passed += 1

    // Test 6: eprintfln compiles and runs (output goes to stderr)
    fmt.eprintfln("eprintfln test: %d", {123})
    println("  [PASS] eprintfln runs without crash")
    passed += 1

    // Test 7: sprintf with newline with f64
    mut s4 string = fmt.sprintf("pi = %.2f\n", {3.14})
    if s4 == "pi = 3.14\n" {
        println("  [PASS] sprintf with newline with f64")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf with newline with f64")
        failed += 1
    }

    // Test 8: sprintf with newline with no extra args (just format string)
    mut s5 string = fmt.sprintf("no args here\n", {})
    if s5 == "no args here\n" {
        println("  [PASS] sprintf with newline no args")
        passed += 1
    } otherwise {
        println("  [FAIL] sprintf with newline no args")
        failed += 1
    }

    println("")
    println("Results: ${passed} passed, ${failed} failed")
    if failed > 0 {
        println("SOME TESTS FAILED")
        exit(1)
    } otherwise {
        println("ALL TESTS PASSED")
    }
}
