import @os

do main() {
    // seq 1 2000 generates ~8 KB of output, enough to trigger buffer growth
    mut result, err = os.exec("seq", {"1", "2000"})
    if err != nil || result.exit_code != 0 {
        println("SOME TESTS FAILED: exec failed (code=${result.exit_code})")
        exit(1)
    }
    if len(result.stdout) < 4096 {
        println("SOME TESTS FAILED: expected >4096 bytes, got ${len(result.stdout)}")
        exit(1)
    }

    println("All exec large output tests passed (${len(result.stdout)} bytes captured)")
}
